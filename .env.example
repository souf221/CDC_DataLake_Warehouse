# =============================================================================
# CDC Data Lakehouse - Configuration environnement
# Copier ce fichier vers .env et adapter les valeurs
# =============================================================================

# Mode de données : sample (test rapide) | full (5GB+, pagination complète 30-60 min)
DATA_MODE=sample

# Token Socrata recommandé en mode full (limites API plus élevées)
# Obtenir sur https://data.cdc.gov/profile/edit/developer_settings
CDC_APP_TOKEN=

# MinIO (S3 local)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cdc-lakehouse
MINIO_SECURE=false

# Spark
SPARK_MASTER=spark://spark-master:7077
SPARK_APP_NAME=cdc-lakehouse

# Delta Lake / Iceberg paths (S3A)
BRONZE_PATH=s3a://cdc-lakehouse/bronze
SILVER_PATH=s3a://cdc-lakehouse/silver
GOLD_PATH=s3a://cdc-lakehouse/gold

# PostgreSQL Data Warehouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=cdc_warehouse
POSTGRES_USER=cdc_user
POSTGRES_PASSWORD=cdc_password

# Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@airflow-postgres/airflow
AIRFLOW__CORE__FERNET_KEY=your-fernet-key-here-generate-with-python
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false

# CDC Socrata API (données publiques)
CDC_API_BASE_URL=https://data.cdc.gov/resource

# Monitoring
PROMETHEUS_PORT=8000
METRICS_PUSHGATEWAY=http://pushgateway:9091

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Metabase
METABASE_DB=metabase
